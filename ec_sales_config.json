  "mapping": {
    "version": 1,
    "leadDays": 2,
    "leadOverrides": [],
    "rules": [
      {
        "id": "single-tcbk",
        "scope": "single",
        "label": "テーブルコンテナ ブラック（単品）",
        "pattern": "^(テーブルコンテナ グレー/ブラック - ブラック|TCBK)$",
        "code": "TCBK",
        "net": 7000
      },
      {
        "id": "single-tc",
        "scope": "single",
        "label": "テーブルコンテナ グレー（単品）",
        "pattern": "^(テーブルコンテナ グレー/ブラック - グレー|テーブルコンテナ|TC)$",
        "code": "TC",
        "net": 7000
      },
      {
        "id": "single-bag",
        "scope": "single",
        "label": "FLATCART 2x4用バッグ",
        "pattern": "2x4用バッグ",
        "code": "OP/2x4-BAG"
      },
      {
        "id": "single-caster",
        "scope": "single",
        "label": "交換用自在キャスター（ブラック用）",
        "pattern": "ブラック用 交換用自在キャスター",
        "code": "P/0000000186",
        "note": "P/2x4BK-80J と重複登録中。統一先は担当者が決める"
      },
      {
        "id": "single-caster-blue",
        "scope": "single",
        "label": "交換用自在キャスター（ブルー用）",
        "pattern": "ブルー用 交換用自在キャスター",
        "code": "P/0000000185",
        "note": "過去の伝票の実績（7〜9月）から。担当者が確認"
      },
      {
        "id": "single-cup",
        "scope": "single",
        "label": "カップホルダー（単品）",
        "pattern": "^OP/CUP|追加カップホルダー",
        "code": "OP/CUP",
        "net": 1200
      },
      {
        "id": "body-dinset-bk",
        "scope": "body",
        "label": "FLATCART DINING＋コンテナ2個セット（ブラック）",
        "pattern": "FLATCART DINING テーブルコンテナ/ブラック\\(2個\\)セット",
        "code": "FCARTDIN",
        "includes": [
          {
            "code": "TCBK",
            "qty": 2,
            "net": 7000
          }
        ]
      },
      {
        "id": "body-dinset-gr",
        "scope": "body",
        "label": "FLATCART DINING＋コンテナ2個セット（グレー）",
        "pattern": "FLATCART DINING テーブルコンテナ/グレー\\(2個\\)セット",
        "code": "FCARTDIN",
        "includes": [
          {
            "code": "TC",
            "qty": 2,
            "net": 7000
          }
        ]
      },
      {
        "id": "body-dinset",
        "scope": "body",
        "label": "FLATCART DINING＋コンテナ2個セット（色は選択肢で決まる）",
        "pattern": "FLATCART DINING テーブルコンテナ\\(2個\\)セット",
        "code": "FCARTDIN",
        "includes": [
          {
            "code": "TC",
            "qty": 2,
            "net": 7000
          }
        ],
        "warn": "セット品のコンテナの色を確認（既定はグレー）"
      },
      {
        "id": "body-din",
        "scope": "body",
        "label": "FLATCART DINING",
        "pattern": "(FLATCART|F-CART) ?DINING",
        "code": "FCARTDIN"
      },
      {
        "id": "body-02",
        "scope": "body",
        "label": "FLATCART 02",
        "pattern": "(FLATCART|F-CART) ?02",
        "code": "FCART02"
      },
      {
        "id": "body-bk",
        "scope": "body",
        "label": "FLATCART 2x4 ブラック",
        "pattern": "FLATCART 2x4\\(ブラック\\)|F-CART 2×4 BK",
        "code": "FCART2x4BK"
      },
      {
        "id": "body-blue",
        "scope": "body",
        "label": "FLATCART 2x4 ブルー",
        "pattern": "FLATCART 2x4\\(ブルー\\)|F-CART 2×4(?! BK)",
        "code": "FCART2x4"
      },
      {
        "id": "body-uxllsc",
        "scope": "body",
        "label": "UXL-LSC",
        "pattern": "^UXL-LSC( |$)",
        "code": "UXLLSC"
      },
      {
        "id": "body-uxalscg",
        "scope": "body",
        "label": "UXA-LSC グレー（アウトレット）",
        "pattern": "^UXA-LSCグレー",
        "code": "UXALSCG"
      },
      {
        "id": "opt-tcbk",
        "scope": "option",
        "label": "テーブルコンテナ(ブラック) N個追加",
        "pattern": "テーブルコンテナ\\(ブラック\\)(\\d+)個",
        "code": "TCBK",
        "qty": "g1",
        "net": 7000
      },
      {
        "id": "opt-tcgr",
        "scope": "option",
        "label": "テーブルコンテナ(グレー) N個追加",
        "pattern": "テーブルコンテナ\\(グレー\\)(\\d+)個",
        "code": "TC",
        "qty": "g1",
        "net": 7000
      },
      {
        "id": "opt-tc",
        "scope": "option",
        "label": "テーブルコンテナ N個追加",
        "pattern": "テーブルコンテナ(\\d+)個",
        "code": "TC",
        "qty": "g1",
        "net": 7000
      },
      {
        "id": "opt-cup",
        "scope": "option",
        "label": "カップホルダー(2個セット)追加",
        "pattern": "カップホルダー\\(2個セット\\)",
        "code": "OP/CUP",
        "qty": 1,
        "net": 1200
      },
      {
        "id": "opt-pb",
        "scope": "option",
        "label": "ペダルブレーキ追加",
        "pattern": "ペダルブレーキ",
        "code": "OP/XLPB",
        "qty": 1,
        "net": 12200,
        "warn": "ペダルブレーキの単価・品目コードを確認（機種で違う可能性）"
      },
      {
        "id": "opt-swap-bk",
        "scope": "option",
        "label": "セット品のコンテナはブラック",
        "pattern": "オプションは注文しない\\(コンテナ/ブラック\\)",
        "swap": {
          "from": "TC",
          "to": "TCBK"
        }
      },
      {
        "id": "opt-swap-gr",
        "scope": "option",
        "label": "セット品のコンテナはグレー",
        "pattern": "オプションは注文しない(コンテナ/グレー)",
        "code": ""
      },
      {
        "id": "opt-none",
        "scope": "option",
        "label": "オプションなし",
        "pattern": "オプションは(注文|追加)しない",
        "code": ""
      }
    ]
  },
  "files": {
